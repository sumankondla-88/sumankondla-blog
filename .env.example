# Copy to .env (or set as Cloudflare build variables). All optional; each feature stays off until set.

# GA4 measurement ID. Rendered in production builds only, behind Consent Mode v2 (denied by default).
PUBLIC_GA_ID=

# giscus comments (GitHub Discussions). Repo must be public with a "Comments" discussion category.
# Get the IDs from https://giscus.app
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY_ID=

# Newsletter (Brevo). See NEWSLETTER.md. The form posts to /api/subscribe by default.
# Runtime secrets/variables on the Worker (Settings -> Variables and Secrets):
BREVO_API_KEY=
BREVO_LIST_ID=
# Optional but recommended: id of a Brevo double opt-in template, so people confirm by email first.
BREVO_DOI_TEMPLATE_ID=

# --- Admin (Keystatic + Cloudflare Access). See ADMIN.md ---
# Build variable. Slug of the GitHub App Keystatic created.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Runtime secrets (Worker -> Settings -> Variables and Secrets), written to .env by the local GitHub App setup.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# Runtime variables used by src/middleware.ts to verify the Cloudflare Access login.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# AI writing desk (server-side secrets; never use PUBLIC_ prefixes).
# Also configure these as Worker secrets for production.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
OPENAI_API_KEY=
# Optional model override. Defaults to gpt-image-2.5-flare.
OPENAI_IMAGE_MODEL=
